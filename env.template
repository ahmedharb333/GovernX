# GovernX Remotion Server — Environment Variables
# Copy this file to .env and fill in your values

# Your Google Drive production folder ID
# Get it from the URL when you open your GovernX folder in Drive:
# https://drive.google.com/drive/folders/YOUR_FOLDER_ID_HERE
DRIVE_FOLDER_ID=your_production_folder_id_here

# ── Research engine (verified-claims worker) ────────────────────────────────
# Anthropic API key — powers claim extraction + independent verification.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for extraction/verification (optional; default claude-sonnet-5)
RESEARCH_MODEL=claude-sonnet-5

# Descriptive User-Agent for fetching regulator/SEC docs (SEC requires contact info)
RESEARCH_USER_AGENT=GovernX-Research/1.0 (your-email@example.com)
